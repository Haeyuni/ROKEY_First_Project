# 브러싱 · 도포용. 상대 경로 또는 base 기준 절대 경로를 추종한다.

geometry_msgs/Pose[] waypoints          # 경로점. circular_via_indices 원소는 MoveC 경유점
int32[] circular_via_indices            # i가 경유점이면 waypoints[i+1]이 해당 MoveC 종료점
string  frame_id                        # waypoints/allowed_polygon 좌표계
string  reference_key                   # 비어 있으면 Pose 전체를 절대값으로 사용
string  session_id

float64 feed_speed_mms
float64 contact_offset_mm               # 티칭점에서 tool +Z 방향 미세 보정

geometry_msgs/Point[] allowed_polygon   # TCP 이탈 감시
int32   passes
float64 max_duration_s
---
nail_msgs/ResultBase base
float64 path_error_mm
int32   passes_done
int32[] missed_segment_indices
string  abort_reason
---
float64 percent
int32   current_pass
