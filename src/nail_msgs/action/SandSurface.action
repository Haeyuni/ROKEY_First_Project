string  session_id

string SIDE_FREE_EDGE = "free_edge"
string SIDE_LEFT      = "left"
string SIDE_RIGHT     = "right"

string  approach_side
float64 approach_pitch_deg              # 0 = 완전 수평
float64 work_plane_offset_mm

int32   passes
float64 step_over_mm
float64 feed_speed_mms
float64 max_duration_s

float64 travel_limit_margin_mm          # 경계까지 거리에서 뺄 안전 마진

# (선택) 수동 지정 왕복 경로 — base_link 절대좌표 기준(targets.yaml 값을
# 변환 없이 그대로 넣을 수 있게 하기 위함 — nail_local_frame 상대좌표
# 변환은 실수하기 쉬워 반복적으로 문제가 됐다). 2개 이상이면 이걸 그대로
# 오실레이션 왕복 경로로 쓰고 경계 계산(진입점/곡선 추출/engagement_depth_mm
# offset/travel_limit_mm 검증)을 전부 건너뛴다. 비어 있으면(기본) 기존처럼
# nail_size_x_mm/y_mm 로 계산한다(그 경로는 nail_local_frame 기준 그대로).
#
# nail_msgs/TaskPose 를 쓴다(geometry_msgs/Pose 가 아님) — 티치펜던트
# TASK 화면의 x_mm/y_mm/z_mm/A(rz1_deg)/B(ry_deg)/C(rz2_deg) 를 quaternion
# 변환 없이 그대로 받는다. ry가 ±180° 근처(이 워크스페이스의 정상 자세)일
# 때 quaternion 왕복 변환이 다른 자세로 튀는 문제가 실기에서 확인돼
# (robot_skill_node.py target_key 조회 경로와 동일 이유) 이 필드도 같은
# 방식을 따른다 — 안전 확인(좌표·자세 둘 다)은 호출자 책임.
nail_msgs/TaskPose[] waypoints
---
nail_msgs/ResultBase base
float64 max_travel_mm
float64 computed_travel_limit_mm        # 이번 세션에 계산된 한계값
int32   passes_done
string  abort_reason
---
float64 percent
int32   current_pass
float64 travel_mm
