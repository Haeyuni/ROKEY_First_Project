string  session_id

string SIDE_FREE_EDGE = "free_edge"
string SIDE_LEFT      = "left"
string SIDE_RIGHT     = "right"

string  approach_side
float64 approach_pitch_deg              # 0 = 완전 수평
float64 work_plane_offset_mm

float64 target_force_n
float64 max_force_n
float64 jam_force_n

int32   passes
float64 step_over_mm
float64 feed_speed_mms
float64 max_duration_s

float64 travel_limit_margin_mm          # 경계까지 거리에서 뺄 안전 마진

# (선택) 수동 지정 왕복 경로 — nail_local_frame 기준, m 단위, 2개 이상이면
# 이걸 그대로 오실레이션 왕복 경로로 쓰고 경계 계산(진입점/곡선 추출/
# engagement_depth_mm offset/travel_limit_mm 검증)을 전부 건너뛴다.
# 비어 있으면(기본) 기존처럼 nail_size_x_mm/y_mm 로 계산한다. 각 Pose 의
# position(x,y,z)과 orientation 을 그대로 쓴다(경계 모드처럼 face-down 으로
# 강제하지 않음) — 안전 확인(좌표·자세 둘 다)은 호출자 책임.
#
# ⚠️ orientation 을 대충 identity(0,0,0,1)로 채우면 이 워크스페이스의
#    실측 자세(B≈±180°, 항상 아래를 보는 자세)와 정반대라 큰 자세 재정렬을
#    시도하다 NOT REACHABLE 로 실패하거나 위험한 궤적이 나올 수 있다
#    (brushing/coating/sanding 에서 반복 확인된 문제, curing_node
#    `_FACE_DOWN_QUAT`=(1,0,0,0) 참고). 반드시 실측된 자세를 quaternion 으로
#    변환해 넣을 것 — 대충 채우려면 차라리 orientation 을 비워두지 말고
#    _FACE_DOWN_QUAT 값을 그대로 복사해 넣는다.
geometry_msgs/Pose[] waypoints
---
nail_msgs/ResultBase base
float64 mean_force_n
float64 max_force_measured_n
float64 max_travel_mm
float64 computed_travel_limit_mm        # 이번 세션에 계산된 한계값
float64 max_jam_force_n
int32   passes_done
string  abort_reason
---
float64 percent
int32   current_pass
float64 travel_mm
nail_msgs/ForceSample current_wrench
