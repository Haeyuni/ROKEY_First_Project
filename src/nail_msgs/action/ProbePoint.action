# 스캔과 택프리 검사가 공유하는 최소 단위.

# 측정 프로파일. 재질이 같은 모형에서는 강성·점탄성 축이 통째로 죽으므로,
# 유지/계단/제하 구간을 재는 게 시간 낭비다. 그런 경우 HEIGHT 로 접촉 높이만
# 가볍게 따면 점당 시간이 1/3 로 줄고, 누르는 힘이 작아 미끄러질 일도 줄어든다.
string PROFILE_FULL   = "full"          # 하강 + 유지 + 계단 + 제하 (전 특징)
string PROFILE_HEIGHT = "height"        # 하강만. 접촉 높이·경사만 필요할 때
string profile                          # 비우면 full

geometry_msgs/Point target
string  frame_id
float64 approach_height_mm
float64 probe_speed_mms
float64 contact_threshold_n
float64 max_depth_mm
float64 max_force_n
float64 lateral_force_limit_n

bool    measure_release                 # true면 이탈 중 Fz 측정 (택프리)
float64 release_speed_mms
string  source_tag                      # StiffnessPoint.source 에 기록

# --- v0.3: 모양 특징을 뽑기 위한 추가 구간 ---------------------------------------
# 하강 곡선만으로는 단단한 면에서 아무것도 못 뽑는다(힘 상한까지 압입이
# 0.1mm 도 안 됨). 위치를 고정한 채 재는 유지·계단·제하 구간이 그 공백을
# 메운다. 전부 0 이면 노드 파라미터 기본값을 쓴다.
float64 dwell_s                         # 접촉 힘 도달 후 유지 시간 → 응력 완화
float64 dither_mm                       # 유지 뒤 추가 압입량 → 계단 강성 ΔF/Δd
float64 dither_dwell_s                  # 계단 압입 후 유지 시간
float64 unload_fraction                 # 부분 제하 목표 (최대 힘 대비 잔여 비율)
float64 slip_ratio_limit                # 접선/법선 힘 비 상한. 넘으면 힘 특징 폐기

# 표면 법선(frame_id 기준). 0 벡터면 현재 툴 자세 그대로 하강한다.
# ⚠️ 이 방향으로 자세를 트는 것은 TCP 가 프로브 팁에 맞춰져 있을 때만
#    안전하다 — robot_skill_node 의 probe_allow_reorient 로 따로 허용해야 한다.
geometry_msgs/Vector3 approach_normal
---
nail_msgs/ResultBase base
nail_msgs/StiffnessPoint point
nail_msgs/ForceSample[] waveform        # 하강+유지+계단+제하 전체 파형
int32   regression_samples              # 회귀에 쓴 표본 수

# waveform 구간 경계. 오프라인 재현·튜닝에서 파형을 다시 나누려면 필요하다.
int32   load_end_index                  # [0, load_end) 가 하강 구간
int32   dwell_end_index                 # [load_end, dwell_end) 가 유지 구간
int32   dither_end_index                # [dwell_end, dither_end) 가 계단 구간
                                        # [dither_end, 끝) 이 제하 구간
float64 tare_noise_n                    # 접근 자세에서 잰 힘 노이즈 (1σ)
---
float64 current_depth_mm
float64 current_force_n
