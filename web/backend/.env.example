# cp .env.example .env 후 값 확인/수정

# web/backend/app/config.py 기본값과 동일 — 팀 원격 DB를 쓰면 이 값만 바꾼다
DATABASE_URL=postgresql+asyncpg://nail:nail@localhost:5432/nail_db

# nail_bridge web_bridge.launch.py 가 띄우는 rosbridge_websocket 접속 정보
ROSBRIDGE_HOST=localhost
ROSBRIDGE_PORT=9090

# orchestrator 액션 서버 응답 대기 시간(초) — FR-06
RUN_SESSION_TIMEOUT_S=3.0

# 콤마로 여러 origin 지정 가능
CORS_ORIGINS=http://localhost:5173
