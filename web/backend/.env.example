# web/backend/.env 로 복사해서 사용하세요.

# docker compose 기본값과 일치. 팀 공용 DB를 쓰면 여기만 바꾸면 됩니다.
DATABASE_URL=postgresql+asyncpg://nail:nailpassword@193.123.162.167:5432/nail_db

# rosbridge_server (nail_bridge 패키지가 띄우는 rosbridge_websocket) 접속 정보.
# NIS §9 / nail_bridge/config/web_bridge.yaml 의 websocket_port 와 일치해야 함.
ROSBRIDGE_HOST=localhost
ROSBRIDGE_PORT=9090

# FR-06: 액션 서버(orchestrator)가 응답 없을 때 대기할 시간.
RUN_SESSION_TIMEOUT_S=3.0

# React 개발 서버 오리진 (CORS)
CORS_ORIGINS=http://localhost:5173
